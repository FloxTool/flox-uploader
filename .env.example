# Copier ce fichier en .env et remplir avec tes vraies cles.
# .env est ignore par Git - il ne doit JAMAIS etre commit.

# URL d'announce du tracker, contient ta passkey personnelle
# La trouver sur ton profil du tracker (page de téléchargement d'un torrent)
# Exemple format : https://tracker.exemple.org/announce/<passkey>
TRACKER_ANNOUNCE=

# TMDB : clé v3 (gratuite) pour résoudre les titres et récupérer les métadonnées
# Récupérer sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OMDb : clé gratuite (1000 req/jour) pour la note IMDb et le poster fallback
# Récupérer sur https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
