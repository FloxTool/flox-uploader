{# ============================================================
   Template BBCode pour les uploads Livres / BD / Manga (cat 12 Gemini)
   Sprint D.8 v0.5.0 — refonte harmonisee avec template_movie.bbcode
   (memes blocs : header titre, separateurs visuels, blocs infos /
   release / source, footer enjoy).

   Variables disponibles (BookMetadata serialise) :
   - meta.title, meta.subtitle, meta.authors (liste), meta.publisher,
     meta.publication_year, meta.language, meta.page_count,
     meta.isbn_13, meta.isbn_10, meta.series, meta.series_index,
     meta.description, meta.cover_url, meta.genres (liste), meta.sources,
     meta.file_format
   - release_name : str
   - tracker_name : str (ex: "Gemini")
   ============================================================ #}
{%- set isbn = meta.isbn_13 or meta.isbn_10 -%}
{%- set authors_str = meta.authors | join(", ") if meta.authors else "" -%}
{%- set lang_label = {"fr": "Français", "en": "Anglais", "es": "Espagnol", "de": "Allemand", "it": "Italien", "pt": "Portugais", "ja": "Japonais", "zh": "Chinois", "ru": "Russe", "ar": "Arabe", "ko": "Coréen", "nl": "Néerlandais"}.get(meta.language, meta.language | upper if meta.language else "") -%}
{%- set title_safe = meta.title or release_name -%}
{%- set year_str = meta.publication_year | string if meta.publication_year else "" -%}

[center]
{%- if meta.cover_url %}
{# Sprint D.18 v0.5.0 : cover_url est garanti externe (https) ou vide
   ici, le caller bbcode_book.pick_bbcode_cover_url filtre les covers
   locales /packages/... qui ne sont pas accessibles depuis le tracker. #}
[img=300]{{ meta.cover_url }}[/img]
{% endif %}
[color=#C9B27D][b][size=30]📚 {{ title_safe }} 📚[/size][/b][/color]
{% if year_str %}{{ year_str }}{% endif %}

[color=#C9B27D][b]{% if authors_str %}{{ authors_str }}{% else %}Auteur inconnu{% endif %}{% if lang_label %} · {{ lang_label }}{% endif %}{% if meta.file_format %} · {{ meta.file_format | upper }}{% endif %}[/b][/color]

[img=500]https://i.imgur.com/jOSyeDp.png[/img]

{# Sprint D.19 v0.5.0 (note Louis Q3) : ligne de 4 previews (apercu pages)
   uploadees sur imgbb. Placement equivalent du lien YouTube sur la prez
   film. Visible seulement si on a au moins 1 preview URL externe.
   Sprint D.22 (note Louis N-UX1) : taille augmentee a 250 pour mieux
   voir les previews sur la fiche tracker. #}
{%- if meta.preview_urls %}
{%- for purl in meta.preview_urls[:4] %}[img=250]{{ purl }}[/img] {% endfor %}

[img=500]https://i.imgur.com/jOSyeDp.png[/img]

{% endif %}

{# Section liens externes harmonisee avec films (ratings_section) #}
{%- if isbn %}
[color=#8B8680]ISBN :[/color] [b]{{ isbn }}[/b]
{% endif %}
{%- if meta.bnf_ark %}
[color=#8B8680]Fiche BnF :[/color] [url={{ meta.bnf_ark | bnf_url }}]catalogue.bnf.fr[/url]
{% endif %}
{%- if meta.google_books_id %}
[color=#8B8680]Google Books :[/color] [url={{ meta.title | google_books_url(meta.google_books_id) }}]books.google.com[/url]
{% endif %}

[img=500]https://i.imgur.com/ZHUrtS7.png[/img]

[color=#C9B27D][b][size=20]📖 Informations sur le livre 📖[/size][/b][/color]

[color=#8B8680]Auteur(s) :[/color] {% if authors_str %}{{ authors_str }}{% else %}[i]Inconnu[/i]{% endif %}
{%- if meta.publisher %}
[color=#8B8680]Éditeur :[/color] {{ meta.publisher }}
{%- endif %}
{%- if year_str %}
[color=#8B8680]Année :[/color] {{ year_str }}
{%- endif %}
{%- if lang_label %}
[color=#8B8680]Langue :[/color] {{ lang_label }}
{%- endif %}
{%- if meta.page_count %}
[color=#8B8680]Pages :[/color] {{ meta.page_count }}
{%- endif %}
{%- if meta.series %}
[color=#8B8680]Série :[/color] [b]{{ meta.series }}[/b]{% if meta.series_index %} — tome {{ meta.series_index | round(1) | int if (meta.series_index | round(1)) == (meta.series_index | int) else meta.series_index }}{% endif %}
{%- endif %}
{%- if meta.genres %}
[color=#8B8680]Genres :[/color] {{ meta.genres | join(", ") }}
{%- endif %}

[img=500]https://i.imgur.com/ZHUrtS7.png[/img]

[color=#C9B27D][b][size=20]📝 Résumé 📝[/size][/b][/color]

{% if meta.description %}{{ meta.description }}{% else %}[i]Aucun résumé disponible pour ce livre. Les providers BnF / Google Books / OpenLibrary n'ont rien fourni — il est conseillé d'éditer la fiche manuellement avant l'upload.[/i]{% endif %}

[img=500]https://i.imgur.com/jOSyeDp.png[/img]

[color=#C9B27D][b][size=20]💿 Informations sur la release 💿[/size][/b][/color]

[color=#8B8680]Titre :[/color] {{ release_name }}
[color=#8B8680]Format :[/color] {% if meta.file_format %}{{ meta.file_format | upper }}{% else %}Inconnu{% endif %}
{%- if meta.page_count %}
[color=#8B8680]Pages :[/color] {{ meta.page_count }}
{%- endif %}
{%- set _ti_size = torrent_info.get('size_pretty', '') if torrent_info else '' %}
{%- set _ti_count = torrent_info.get('file_count', 0) if torrent_info else 0 %}
{%- set _ti_files = torrent_info.get('files', []) if torrent_info else [] %}
{%- set _ti_tree_lines = torrent_info.get('tree_lines', []) if torrent_info else [] %}
{%- set _ti_truncated = torrent_info.get('truncated', false) if torrent_info else false %}
{%- if _ti_size %}
[color=#8B8680]Taille totale :[/color] {{ _ti_size }}
{%- endif %}
{%- if _ti_count and _ti_count > 1 %}
[color=#8B8680]Nombre de fichiers :[/color] {{ _ti_count }}
{%- endif %}
{%- if meta.sources %}
[color=#8B8680]Métadonnées :[/color] {{ meta.sources | join(", ") }}
{%- endif %}

{%- if _ti_count and _ti_count > 1 %}

[color=#C9B27D][b]Contenu du torrent[/b][/color]
[code]
{%- if _ti_tree_lines %}
{# Sprint D.25 v0.5.0 (note Louis N-R4) : on prefere le tree hierarchique
   qui montre les sous-dossiers (PDF/, CBZ/, etc.). Fallback liste flat
   pour les anciens packages dont torrent_info n'a pas tree_lines. #}
{%- for line in _ti_tree_lines %}
{{ line }}
{%- endfor %}
{%- elif _ti_files %}
{%- for f in _ti_files %}
{{ f.name }}{% if f.size_pretty %} ({{ f.size_pretty }}){% endif %}
{%- endfor %}
{%- endif %}
{%- if _ti_truncated %}
... (tronqué à 50 fichiers)
{%- endif %}
[/code]
{%- endif %}

[img=500]https://i.imgur.com/ZHUrtS7.png[/img]

[color=#C9B27D][b]🔥 Bonne lecture ! 🔥[/b][/color]

[/center]
